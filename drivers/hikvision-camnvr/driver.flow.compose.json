  "actions": [
    {
      "id": "ptzcontinuous",
      "title": {
        "en": "Relative PTZ",
        "nl": "Relative PTZ",
        "de": "Relativer PTZ"
      },
      "titleFormatted": {
        "en": "Set relative PTZ: Cam: [[channel]] Pan: [[pannumber]] Tilt: [[tiltnumber]] Zoom: [[zoomnumber]]"
      },
      "hint": {
        "en": "Relative Values (-100 to 100)",
        "nl": "Relative Values(-100 to 100)",
        "de": "Relative Werte (-100 bis 100)"
      },
      "args": [
        {
          "name": "pannumber",
          "type": "number",
          "min": -100,
          "max": 100,
          "step": 0.1,
          "placeholder": {
            "en": "Pan number",
            "nl": "Pan nummer",
            "de": "Pan nummer"
          }
        },
        {
          "name": "tiltnumber",
          "type": "number",
          "min": -100,
          "max": 100,
          "step": 0.1,
          "placeholder": {
            "en": "Tilt number",
            "nl": "Tilt nummer",
            "de": "Tilt nummer"
          }
        },
        {
          "name": "zoomnumber",
          "type": "number",
          "min": -100,
          "max": 100,
          "step": 0.1,
          "placeholder": {
            "en": "Zoom number",
            "nl": "Zoom nummer",
            "de": "Zoom nummer"
          }
        },
        {
          "name": "channel",
          "type": "number",
          "min": 0,
          "max": 36,
          "step": 1,
          "placeholder": {
            "en": "Camera Number",
            "nl": "Camera Number",
            "de": "Kamera Nummer"
          }
        }
      ]
    },
    {
      "id": "nvr_start_recording",
      "title": {
        "en": "Start NVR Recording",
        "nl": "Start NVR Opname",
        "de": "NVR Aufnahme Starten"
      },
      "titleFormatted": {
        "en": "Start recording channels [[channels]] for [[duration]] minutes in [[quality]] quality"
      },
      "args": [
        {
          "name": "channels",
          "type": "text",
          "title": {
            "en": "Channels (comma separated)",
            "nl": "Kanalen (komma gescheiden)",
            "de": "Kanäle (kommagetrennt)"
          },
          "placeholder": {
            "en": "1,2,3",
            "nl": "1,2,3",
            "de": "1,2,3"
          }
        },
        {
          "name": "duration",
          "type": "number",
          "min": 1,
          "max": 480,
          "step": 1,
          "title": {
            "en": "Duration (minutes)",
            "nl": "Duur (minuten)",
            "de": "Dauer (Minuten)"
          },
          "placeholder": {
            "en": "30",
            "nl": "30",
            "de": "30"
          }
        },
        {
          "name": "quality",
          "type": "dropdown",
          "title": {
            "en": "Quality",
            "nl": "Kwaliteit",
            "de": "Qualität"
          },
          "values": [
            {
              "id": "ultra",
              "title": {
                "en": "Ultra (4K)",
                "nl": "Ultra (4K)",
                "de": "Ultra (4K)"
              }
            },
            {
              "id": "high",
              "title": {
                "en": "High (1080p)",
